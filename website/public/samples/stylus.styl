// Showcase: Stylus — minimal, expressive CSS.
bg = #0b1120
fg = #e2e8f0
accent = #7c6cf0
radius = .625rem

bordered($w = 1px, $c = #1e293b)
  border $w solid $c

card($pad = 1.5rem)
  bordered()
  border-radius radius
  padding $pad

.playground
  card()
  display grid
  gap 1rem
  background bg
  color fg

  h2
    font-size 1.25rem
    margin 0

  textarea
    width 100%
    font-family ui-monospace, monospace
    &:focus
      outline 2px solid accent

  .actions
    .button
      & + &
        margin-left .5rem
      &[disabled]
        opacity .5

for i in 1..3
  .col-{i}
    grid-column span i

each mode in light dark
  .{mode}
    color-scheme mode

@media (max-width: 56rem)
  .playground
    grid-template-columns 1fr

@keyframes fade-up
  from
    opacity 0
    transform translateY(12px)
  to
    opacity 1
    transform none
