--- /dev/null
+++ b/packages/syntax-highlighter/test/tokenizer.test.mjs
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import { Tokenizer } from "../src/core/tokenizer.ts";
+
+const tk = new Tokenizer({ language: "javascript" });
+
+assert.equal(tk.language, "javascript");
+assert.deepEqual(tk.tokenize(""), []);
+
+const toks = tk.tokenize("const x = 1;");
+assert.ok(toks.length > 0);
+assert.equal(toks[0].type, "keyword");
+
+// Coverage must be contiguous: end of one token starts the next.
+for (let i = 1; i < toks.length; i++) {
+  assert.equal(toks[i].start, toks[i - 1].end);
+}
