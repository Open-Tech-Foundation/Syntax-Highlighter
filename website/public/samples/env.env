# Showcase: dotenv — environment for twelve-factor apps.
# Lines starting with # are comments. Blank lines are ignored.

APP_NAME=highlighter
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_PORT=5173

# Quoting controls expansion and whitespace.
DB_HOST=db.internal
DB_PORT=5432
DB_NAME="highlight db"
DB_USER='app user'
DB_PASSWORD="s3cret with spaces"
GREETING='single $NO_EXPAND here'

# Interpolation of earlier (or shell) variables.
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
LOG_PATH=${APP_NAME:-app}/logs/app.log
CACHE_TTL=${CACHE_TTL:-300}

# Numbers, booleans, and lists are just strings to dotenv.
RETRIES=3
RATIO=0.975
FEATURES=diff-mode,live-share
EMPTY=
SPACED = value with spaces around equals

# Multiline with real newlines inside double quotes.
PRIVATE_KEY="-----BEGIN KEY-----
abc123
-----END KEY-----"
export SHARED_TOKEN=already-exported

# Feature flags and service discovery.
API_VERSION=v2
CDN_URL=https://cdn.example.com/assets
SENTRY_DSN=https://abc123@sentry.example.com/42
REDIS_URL=redis://:pass@cache.internal:6379/0
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=mailer
SMTP_SECURE=true
SESSION_SECRET=please-change-me-in-production
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,de,ta
MAINTENANCE_MODE=false
