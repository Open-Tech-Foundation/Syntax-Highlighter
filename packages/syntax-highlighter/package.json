{
  "name": "@opentf/syntax-highlighter",
  "version": "0.1.0",
  "description": "Modern, renderer-agnostic syntax highlighting with one tokenizer powering browser, HTML/SSR, JSON, and ANSI output.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes/*": "./src/themes/*",
    "./ansi/themes/*": "./src/ansi/themes/*",
    "./ansi/*": "./src/ansi/*"
  },
  "files": [
    "dist",
    "src/themes",
    "src/ansi/themes",
    "src/ansi"
  ],
  "devDependencies": {
    "@opentf/esrun-types": "latest",
    "@opentf/std": "0.18.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Tech-Foundation/Syntax-Highlighter.git"
  },
  "keywords": [
    "syntax-highlighting",
    "syntax-highlighter",
    "css-custom-highlight-api",
    "tokenizer",
    "renderer-agnostic",
    "semantic-tokens",
    "ssr",
    "html",
    "json",
    "ansi",
    "themes",
    "highlight"
  ],
  "license": "MIT"
}
